{
  "schema_version": "memory_continuity_permission_examples.v1",
  "phase": "Phase 2.104b",
  "purpose": "Sanitized examples for low-sensitive memory continuity and permission boundary behavior. These fixtures are documentation and contract examples only; they do not implement runtime memory writes, DB/NAS access, Gateway calls, or evidence search.",
  "core_principle": "Platform permission proof is the authority; catalog permission applies only to current catalog response; Hermes memory continuity is only a low-sensitive UX hint.",
  "safety_rules": {
    "sanitized_only": true,
    "no_real_project_names": true,
    "no_real_file_names": true,
    "no_raw_storage_path": true,
    "no_raw_nas_path": true,
    "no_raw_db_row": true,
    "no_raw_catalog_row": true,
    "no_file_text": true,
    "no_dwg_rvt_bim_content": true,
    "no_secret_token_or_credential": true,
    "related_ids_are_not_content_evidence": true,
    "memory_never_grants_access": true
  },
  "allowed_memory_fields": [
    "related_file_ids",
    "related_model_ids",
    "query_id",
    "trace_id",
    "feedback_label",
    "last_safe_project_context_label",
    "preferred_result_grouping",
    "last_evidence_mode",
    "last_permission_decision_summary"
  ],
  "cases": [
    {
      "case_id": "memory_related_file_allowed_current_scope",
      "memory_input": {
        "related_file_ids": [
          "file_demo_101"
        ],
        "query_id": "query_demo_101",
        "trace_id": "trace_demo_101",
        "last_evidence_mode": "catalog_only",
        "last_permission_decision_summary": "allowed_catalog_only"
      },
      "platform_permission": {
        "status": "allowed_current_scope",
        "tenant_id": "tenant_demo_001",
        "project_scope": "project_scope_demo_001",
        "requester_id": "requester_demo_001",
        "proof_state": "current"
      },
      "catalog_permission_decision": {
        "status": "allowed_catalog_only",
        "source_view": "catalog_metadata_view"
      },
      "expected_memory_action": "use_related_file_as_candidate_context_after_current_permission_check",
      "expected_access_outcome": "allowed_current_scope",
      "safe_user_message": "I can continue from the referenced file after checking current permission. The memory reference is only a context hint, not content evidence.",
      "forbidden_behaviors": [
        "treat_memory_as_permission_proof",
        "treat_related_file_as_content_evidence",
        "skip_current_permission_check",
        "expose_raw_path"
      ],
      "should_store_memory": true,
      "should_use_as_content_evidence": false,
      "should_bypass_permission": false,
      "should_expose_raw_path": false,
      "should_query_evidence": false
    },
