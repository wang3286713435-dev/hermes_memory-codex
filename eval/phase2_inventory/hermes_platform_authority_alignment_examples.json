{
  "schema_version": "hermes_platform_authority_alignment_examples.v1",
  "phase": "Phase 2.105",
  "purpose": "Sanitized fixture cases for Hermes kernel authority and Platform boundary alignment. These cases are docs/contract planning only and do not imply runtime implementation.",
  "safety_rules": [
    "Use fake IDs only.",
    "Do not include real project names, real file names, raw paths, raw rows, raw answer text, secrets, tokens, credentials, or customer-sensitive content.",
    "Platform Gateway remains permission and path-redaction authority.",
    "Hermes remains agent kernel / session / reasoning / orchestration owner.",
    "Data Steward / Catalog is one Hermes capability module, not the whole Hermes identity."
  ],
  "cases": [
    {
      "case_id": "platform_single_turn_plugin_mode_pause",
      "platform_request_shape": {
        "request_id": "request_demo_501",
        "query": "current_user_message_only",
        "session_id": "",
        "thread_id": "",
        "sanitized_context_refs": [],
        "permission_proof_ref": "permission_ref_demo_501"
      },
      "hermes_kernel_contract": {
        "required_behavior": "pause_for_authority_alignment",
        "reason": "Platform request discards session continuity and risks treating Hermes as a stateless plugin.",
        "required_refs": [
          "session_id_or_thread_id",
          "query_id",
          "trace_id"
        ]
      },
      "expected_coupling_health": {
        "safety_health": "green_if_gateway_boundaries_enforced",
        "capability_health": "yellow",
        "architecture_authority_health": "orange"
      },
      "safe_platform_message": "Hermes needs a safe session or thread reference to preserve enterprise agent continuity. A single-turn request can be answered only within the current safe scope.",
      "forbidden_behaviors": [
        "treat_hermes_as_stateless_plugin",
        "make_frontend_reasoning_owner",
        "reuse_history_without_revalidation"
      ],
      "requires_runtime_change": true,
      "requires_platform_change": true,
      "should_preserve_gateway_permission_authority": true,
      "should_make_platform_reasoning_owner": false,
      "should_treat_data_steward_as_whole_hermes": false,
      "should_expose_raw_path": false,
      "should_use_history_without_revalidation": false
    },
    {
