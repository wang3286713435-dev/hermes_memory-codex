{
  "schema_version": "document_evidence_search_contract_examples.v1",
  "phase": "Phase 2.104c",
  "purpose": "Sanitized examples for a future governed document_evidence_search contract. These fixtures are documentation and contract examples only; they do not implement runtime search, parser execution, DB/NAS/Gateway access, or index writes.",
  "core_principle": "No document content answer without current platform permission proof, evidence availability that allows governed evidence query, and citation-bearing evidence from an authorized evidence path.",
  "safety_rules": {
    "sanitized_only": true,
    "no_real_project_names": true,
    "no_real_file_names": true,
    "no_raw_storage_path": true,
    "no_raw_nas_path": true,
    "no_raw_db_row": true,
    "no_secret_token_or_credential": true,
    "catalog_metadata_is_not_content_evidence": true,
    "memory_refs_are_not_content_evidence": true,
    "dwg_rvt_bim_understanding_is_not_current": true
  },
  "status_enum": [
    "ready_for_evidence_query",
    "blocked_permission_denied",
    "blocked_catalog_only",
    "blocked_parser_required",
    "blocked_unsupported_type",
    "blocked_memory_reference_only",
    "manual_review_required",
    "query_executed_with_citations",
    "query_executed_missing_evidence"
  ],
