    "no_raw_nas_path": true,
    "no_raw_db_row": true,
    "no_raw_catalog_row": true,
    "no_secret_token_or_credential": true,
    "feedback_is_not_document_evidence": true,
    "feedback_is_not_permission_proof": true,
    "feedback_does_not_auto_repair": true
  },
  "allowed_feedback_labels": [
    "helpful",
    "wrong_document",
    "missing_evidence",
    "wrong_boundary",
    "citation_problem",
    "permission_problem",
    "overclaim",
    "needs_human_review",
    "irrelevant_result"
  ],
