{
  "schema_version": "evidence_availability_contract_examples.v1",
  "phase": "Phase 2.104a",
  "purpose": "Sanitized examples for the Evidence Availability Contract. These fixtures are documentation and contract examples only; they do not implement runtime search, parser execution, DB/NAS access, or index writes.",
  "safety_rules": {
    "sanitized_only": true,
    "no_real_project_names": true,
    "no_real_file_names": true,
    "no_raw_storage_path": true,
    "no_raw_nas_path": true,
    "no_raw_db_row": true,
    "no_asset_uid": true,
    "no_source_id": true,
    "no_secret_token_or_credential": true,
    "catalog_metadata_is_not_content_evidence": true,
    "related_file_ids_are_not_content_evidence": true
  },
  "status_enum": [
    "catalog_only",
    "parser_required",
    "evidence_indexed",
    "unsupported_type",
    "permission_denied",
    "manual_review_required"
  ],
  "cases": [
