      "user_question": "这个图纸里有哪些图层？",
      "source_kind": "dwg_asset",
      "source_view": "catalog_metadata_view",
      "file_id": "file_demo_001",
      "model_id": null,
      "document_id": null,
      "version_id": null,
      "query_id": "query_demo_001",
      "trace_id": "trace_demo_001",
      "evidence_availability_status": "catalog_only",
      "permission_decision": "allowed_catalog_only",
      "safe_user_message": "I can identify the candidate DWG asset from authorized catalog metadata, but I do not have governed DWG layer evidence for this question.",
      "missing_evidence_reason": "catalog_metadata_only_no_dwg_parse_evidence",
      "allowed_next_actions": [
        "show_safe_catalog_metadata",
        "ask_for_manual_review",
        "request_future_parser_or_evidence_indexing"
      ],
      "forbidden_actions": [
        "claim_dwg_layers_were_read",
        "treat_catalog_as_content_evidence",
        "expose_raw_path",
        "invoke_parser",
        "query_vector_store_without_indexed_evidence"
      ],
      "expected_answer_boundary": "Return Missing Evidence for DWG layer content. Catalog metadata may identify a candidate file but cannot verify layers.",
      "should_treat_catalog_as_content_evidence": false,
      "should_expose_raw_path": false,
      "should_invoke_parser": false,
      "should_query_vector_store": false
